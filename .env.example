# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-1234567890abcdef
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DB_NAME=hallbook_db
DB_USER=hallbook_user
DB_PASSWORD=hallbook_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payment Gateway (Razorpay Test Mode / Production)
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HallBook Notifications <notifications@hallbook.in>
